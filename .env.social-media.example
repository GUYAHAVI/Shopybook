# Social Media Environment Variables Template
# Copy these to your .env file and replace with your actual values

# =================================
# FREE PLATFORMS (Start Here!)
# =================================

# Telegram Bot (100% FREE)
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot (100% FREE)  
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Reddit API (FREE with rate limits)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback

# =================================
# BUSINESS PLATFORMS (Optional)
# =================================

# Facebook & Instagram (FREE but requires business verification)
# Get from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# Twitter/X API (PAID: $100/month basic plan)
# Get from: https://developer.twitter.com/
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
TWITTER_REDIRECT_URI=http://localhost:8000/auth/twitter/callback

# LinkedIn API (Apply for partnership)
# Get from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# TikTok API (Apply for business access)
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_ID=your_tiktok_client_id_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback

# YouTube API (FREE with quotas)
# Get from: https://console.developers.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# Pinterest API (FREE for businesses)
# Get from: https://developers.pinterest.com/
PINTEREST_CLIENT_ID=your_pinterest_client_id_here
PINTEREST_CLIENT_SECRET=your_pinterest_client_secret_here
PINTEREST_REDIRECT_URI=http://localhost:8000/auth/pinterest/callback

# WhatsApp Business API (Contact Meta for pricing)
# Get from: https://developers.facebook.com/docs/whatsapp
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Snapchat API (Apply for access)
# Get from: https://developers.snapchat.com/
SNAPCHAT_CLIENT_ID=your_snapchat_client_id_here
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret_here
SNAPCHAT_REDIRECT_URI=http://localhost:8000/auth/snapchat/callback

# =================================
# SETUP INSTRUCTIONS
# =================================

# 1. Copy the FREE platform variables to your .env file
# 2. Follow QUICK_START_FREE_PLATFORMS.md for step-by-step setup
# 3. Run: php artisan config:clear
# 4. Visit: http://localhost:8000/marketing/social-media
# 5. Connect your accounts and start posting!

# Total FREE setup time: ~12 minutes
# Start with Telegram, Discord, and Reddit - they're the easiest!
