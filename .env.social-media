# Social Media API Configurations
# Add these to your .env file

# Facebook App Configuration (from developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=756422230161406
FACEBOOK_CLIENT_SECRET=affb57a33bcb327fd870911f821ea370
FACEBOOK_REDIRECT_URI=https://shopybook.com/auth/facebook/callback

# Instagram uses same Facebook app credentials
INSTAGRAM_CLIENT_ID=756422230161406
INSTAGRAM_CLIENT_SECRET=affb57a33bcb327fd870911f821ea370
INSTAGRAM_REDIRECT_URI=https://shopybook.com/auth/instagram/callback

# Twitter API v2
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Instructions:
# 
# FACEBOOK SETUP (You have the app already!):
# 1. Go to: https://developers.facebook.com/apps/
# 2. Click your "shopybookpro" app
# 3. Go to: App Settings → Basic
# 4. Copy your "App ID" → put in FACEBOOK_CLIENT_ID above
# 5. Click "Show" next to "App Secret" → put in FACEBOOK_CLIENT_SECRET above
# 6. Go to: Products → Facebook Login → Settings
# 7. Add Valid OAuth Redirect URI: http://localhost:8000/auth/facebook/callback
# 8. Save changes
#
# INSTAGRAM SETUP (uses same Facebook app):
# 1. In your Facebook app, go to: Products
# 2. Click "+ Add Product" and add "Instagram Basic Display"
# 3. Go to: Instagram Basic Display → Settings
# 4. Add OAuth Redirect URI: http://localhost:8000/auth/instagram/callback
# 5. Use same App ID and Secret as Facebook (they share credentials)
#
# TWITTER SETUP:
# 1. Go to: https://developer.twitter.com/en/portal/dashboard
# 2. Create new project/app or use existing
# 3. Go to app settings → Keys and tokens
# 4. Copy Client ID and Client Secret
# 5. In app settings → Authentication settings
# 6. Add callback URL: http://localhost:8000/auth/twitter/callback
#
# LINKEDIN SETUP:
# 1. Go to: https://www.linkedin.com/developers/apps
# 2. Create new app (need LinkedIn Company Page)
# 3. Go to: Auth tab
# 4. Copy Client ID and Client Secret  
# 5. Add redirect URL: http://localhost:8000/auth/linkedin/callback
