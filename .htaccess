<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Avoid rewriting requests already inside public
    RewriteRule ^public/ - [L]

    # Serve static assets (css, js, img, storage symlink) from public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send all other requests into the public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
